# Database configuration (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eaos

# CORS Configuration (comma-separated origins)
# In production, set to your Netlify URL: https://your-site.netlify.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare Turnstile Server-side Secret Key
# Dev/test dummy key: 1x000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x000000000000000000000000000000AA

# Admin Dashboard Access Token (Protect /api/admin/leads)
ADMIN_TOKEN=dev_admin_token

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# External Portal configuration (Optional: Used for sync CLI)
PORTAL_BASE_URL=https://info.studyfans.com
PORTAL_COOKIE_CONNECT_SID=fake_studyfans_connect_sid_cookie_here
SYNC_PAGE_SIZE=100

# Optional: Telegram Notifications for new leads
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
